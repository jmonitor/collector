            {
                "query_sample": "COPY (SELECT COALESCE(json_agg(row_to_json(t)), '[]'::json)::text FROM (SELECT\\n                     a.pid                                              AS blocked_pid,\\n                     EXTRACT(EPOCH FROM (now() - a.state_change))::int AS blocked_wait_seconds,\\n                     LEFT(a.query, 500)                                 AS blocked_query_sample,\\n                     bl.pid                                             AS blocking_pid,\\n                     LEFT(bl.query, 500)           ",
                "exec_count": 1,
                "total_time_ms": 8.22,
                "avg_time_ms": 8.22,
                "max_time_ms": 8.22,
                "stddev_time_ms": 0,
                "rows": 1,
                "shared_blks_hit": 626,
                "shared_blks_read": 0
            },
            {
                "query_sample": "COPY (SELECT COALESCE(json_agg(row_to_json(t)), '[]'::json)::text FROM (SELECT COUNT(*) AS cnt,\\n                        EXTRACT(EPOCH FROM max(now() - state_change))::int AS oldest_seconds\\n                 FROM pg_stat_activity\\n                 WHERE datname = current_database() AND state = 'idle in transaction') t) TO STDOUT",
                "exec_count": 1,
                "total_time_ms": 7.32,
